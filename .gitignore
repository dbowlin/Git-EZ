# ==============================================================================
# Git Ignore Rules for C / C++ Project (git-ez)
# ==============================================================================

# ------------------------------------------------------------------------------
# Compiled Binaries & Build Output
# ------------------------------------------------------------------------------
build/
dist/
out/
bin/

# Executables
*.exe
!bin/git-ez.exe
*.out
*.app
*.bin

# Object & Intermediate Files
*.o
*.obj
*.i
*.s

# Static & Dynamic Libraries
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# Debug Symbols & Profiling
*.pdb
*.ilk
*.idb
*.dSYM/
*.suo
*.gcno
*.gcda
*.gcov

# ------------------------------------------------------------------------------
# CMake & Build Systems
# ------------------------------------------------------------------------------
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
Makefile.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
cmake-build-*/

# ------------------------------------------------------------------------------
# IDEs & Editor Configurations
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates

# CLion / JetBrains
.idea/
*.iml

# Vim / Emacs / Sublime
*.swp
*.swo
*~
.#*
\#*#

# ------------------------------------------------------------------------------
# Operating System Metadata
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Logs, Temp & Crash Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.dmp
core
vgcore.*
